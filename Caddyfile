{
	admin off
	auto_https off
}

:8080 {
	root * /delivery-dashboard

	@static {
		path /assets/* /favicon.ico
		file
	}
	@config {
		path /dynamic/config.js
		file
	}

	# handle blocks with matchers are mutually exclusive — first match wins.

	# config.js is rewritten by the init container on pod restart — never cache.
	handle @config {
		header Cache-Control "no-store"
		file_server {
			precompressed gzip
		}
	}

	# Vite content-hashes every asset filename, plus favicon which never changes — immutable forever.
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed gzip
		}
	}

	# Everything else (index.html, manifest): revalidate on every request.
	handle {
		header Cache-Control "no-cache"
		file_server {
			precompressed gzip
		}
	}
}
